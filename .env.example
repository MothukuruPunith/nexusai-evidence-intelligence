# Generate unique local credentials with: uv run python scripts/configure_local.py
# Never commit .env. URLs use the explicit psycopg driver.
NEXUS_DATABASE_URL=
NEXUS_ANALYTICS_DATABASE_URL=
NEXUS_MIGRATION_DATABASE_URL=
NEXUS_ADMIN_DATABASE_URL=
POSTGRES_DB=nexusai
POSTGRES_USER=nexus_bootstrap
POSTGRES_PASSWORD=
NEXUS_DB_PORT=55432

NEXUS_DATA_DIR=data
NEXUS_MODEL_DIR=artifacts/embedding

NEXUS_OLLAMA_URL=http://127.0.0.1:11434
NEXUS_LLM_MANIFEST=artifacts/llm/manifest.json
# -1: automatic GPU selection; 0: CPU when Metal is unavailable
NEXUS_LLM_GPU_LAYERS=-1
